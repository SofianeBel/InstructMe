<Window x:Class="InstructMe.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InstructMe"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Black"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Liquid Glass: a blurred copy of the frozen capture shows through a light tint,
             an edge highlight, and a soft shadow. The blur itself is the GlassBackdrop layer. -->
        <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#9EFFFFFF" Offset="0" />
            <GradientStop Color="#78F4F6FA" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F2FFFFFF" Offset="0" />
            <GradientStop Color="#40FFFFFF" Offset="0.5" />
            <GradientStop Color="#99FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <DropShadowEffect x:Key="GlassShadow" BlurRadius="36" ShadowDepth="8" Direction="270" Opacity="0.35" Color="#0B1020" />

        <Style x:Key="Glass" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Effect" Value="{StaticResource GlassShadow}" />
        </Style>

        <SolidColorBrush x:Key="Ink" Color="#16181D" />
        <SolidColorBrush x:Key="InkSoft" Color="#454A55" />
        <SolidColorBrush x:Key="Accent" Color="#0A84FF" />

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#80FFFFFF" CornerRadius="15"
                                Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpeakButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="40" Height="40" CornerRadius="20"
                                Background="#66FFFFFF" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B3FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpeakSentenceButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="34" CornerRadius="17" Padding="14,0,16,0"
                                Background="#66FFFFFF" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                <TextBlock Text="Écouter la phrase" FontSize="14" FontWeight="Medium" Margin="8,0,0,1"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B3FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- The frozen game image and the word hit areas share capture-pixel coordinates. -->
        <Viewbox Stretch="Fill">
            <Grid x:Name="ImageSpace">
                <Image x:Name="FrozenImage" Stretch="None" />
                <Canvas x:Name="WordLayer" Background="#01000000" MouseLeftButtonDown="OnBackgroundClick">
                    <Border x:Name="SelectionBox" Visibility="Collapsed" IsHitTestVisible="False"
                            CornerRadius="7" BorderThickness="2.5" BorderBrush="{StaticResource Accent}" Background="#2E0A84FF">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.85" Color="#0A84FF" />
                        </Border.Effect>
                    </Border>
                </Canvas>
                <Canvas x:Name="RegionLayer" Background="#18000000" Visibility="Collapsed" Cursor="Cross"
                        MouseLeftButtonDown="OnRegionMouseDown" MouseMove="OnRegionMouseMove" MouseLeftButtonUp="OnRegionMouseUp">
                    <Border x:Name="RegionBox" Visibility="Collapsed" IsHitTestVisible="False"
                            BorderThickness="2" BorderBrush="{StaticResource Accent}" Background="#280A84FF" />
                </Canvas>
            </Grid>
        </Viewbox>

        <!-- Blurred copy of the capture, clipped to the shape of every glass panel. -->
        <Viewbox x:Name="GlassBackdrop" Stretch="Fill" IsHitTestVisible="False">
            <Image x:Name="BlurredImage" Stretch="None">
                <Image.Effect>
                    <BlurEffect Radius="14" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
        </Viewbox>

        <Canvas x:Name="UiLayer">
            <Border x:Name="StatusPill" Style="{StaticResource Glass}" CornerRadius="20" Padding="24,9,24,10">
                <TextBlock x:Name="StatusText" FontSize="17" FontWeight="Medium" Foreground="{StaticResource Ink}" Text="Capture…" />
            </Border>

            <Border x:Name="RecoveryToolbar" Style="{StaticResource Glass}" CornerRadius="20" Padding="8">
                <WrapPanel>
                    <Button Style="{StaticResource ActionButton}" Content="Relire une zone" Click="OnRegionClick" Margin="3"
                            ToolTip="Dessinez un rectangle autour du texte à relire (R)" />
                    <Button Style="{StaticResource ActionButton}" Content="Tout l’écran" Click="OnFullScanClick" Margin="3" />
                    <Button Style="{StaticResource ActionButton}" Content="Saisir / corriger" Click="OnCorrectClick" Margin="3"
                            ToolTip="Corriger le mot et son contexte, ou les saisir si l’OCR ne les trouve pas (E)" />
                    <Button Style="{StaticResource ActionButton}" Content="Mon vocabulaire" Click="OnVocabularyClick" Margin="3"
                            ToolTip="Retrouver les traductions de vos sessions (H)" />
                </WrapPanel>
            </Border>

            <Border x:Name="HintBar" Style="{StaticResource Glass}" CornerRadius="22" Padding="28,11,28,12">
                <TextBlock x:Name="HintText" FontSize="14" Foreground="{StaticResource Ink}" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Clic / A : expliquer · Maj + clic / RB : étendre · Y / P : écouter · R : relire une zone · E : corriger · H : vocabulaire · B / Échap : quitter" />
            </Border>

            <Border x:Name="Card" Style="{StaticResource Glass}" CornerRadius="26" Width="400" Padding="24,18,24,22" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="CardMeta" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}"
                                   VerticalAlignment="Center" Text="ANGLAIS" />
                        <Button x:Name="SpeakButton" Style="{StaticResource SpeakButton}" HorizontalAlignment="Right"
                                ToolTip="Écouter le mot  (P · Y)" Click="OnSpeakClick" />
                    </Grid>
                    <TextBlock x:Name="CardWord" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock x:Name="CardIpa" FontSize="18" Foreground="{StaticResource InkSoft}" Margin="0,0,0,0" />
                    <Border Height="1" Background="#59FFFFFF" Margin="0,14,0,12" />
                    <TextBlock x:Name="CardTranslation" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CardMeaning" FontSize="17" Foreground="#2A2E36" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="25" />
                    <Button x:Name="SpeakSentenceButton" Style="{StaticResource SpeakSentenceButton}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" ToolTip="Écouter la phrase du jeu  (Maj+P · X)" Click="OnSpeakSentenceClick" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="RetryButton" Style="{StaticResource ActionButton}" Content="Réessayer" Click="OnRetryClick"
                                ToolTip="Relancer la recherche (F5)" Visibility="Collapsed" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ActionButton}" Content="Corriger le texte" Click="OnCorrectClick" />
                    </WrapPanel>
                    <TextBlock x:Name="SavedText" FontSize="12" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="CorrectionEditor" Style="{StaticResource Glass}" CornerRadius="26" Width="560" Padding="24" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Saisir ou corriger le texte" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Le contexte aide à trouver le bon sens. Vous pouvez aussi saisir un texte que l’OCR n’a pas reconnu."
                                   FontSize="14" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="0,8,0,18" />
                        <TextBlock Text="Mot ou expression en anglais" FontSize="14" Foreground="{StaticResource Ink}" />
                        <TextBox x:Name="PhraseBox" FontSize="18" Padding="10,8" Margin="0,6,0,16" MaxLength="160"
                                 AutomationProperties.Name="Mot ou expression en anglais" />
                        <TextBlock Text="Phrase du jeu (contexte)" FontSize="14" Foreground="{StaticResource Ink}" />
                        <TextBox x:Name="ContextBox" FontSize="16" Padding="10,8" Margin="0,6,0,12" MinHeight="85" MaxHeight="160"
                                 MaxLength="2400" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Phrase du jeu" />
                        <TextBlock x:Name="CorrectionError" Foreground="#A3261F" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ActionButton}" Content="Annuler" Click="OnCancelCorrectionClick" Margin="0,0,10,0" />
                            <Button Style="{StaticResource ActionButton}" Content="Expliquer" Click="OnTranslateCorrectionClick" ToolTip="Ctrl + Entrée" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Canvas>
    </Grid>
</Window>
