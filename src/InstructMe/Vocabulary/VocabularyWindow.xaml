<Window x:Class="InstructMe.Vocabulary.VocabularyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mon vocabulaire · InstructMe" Width="980" Height="680" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#F2F5FA" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#16181D" />
        <SolidColorBrush x:Key="InkSoft" Color="#5A606B" />
        <SolidColorBrush x:Key="Accent" Color="#0A84FF" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#DFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="#E7EFFB" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Definition.Word}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Item" Padding="{TemplateBinding Padding}" CornerRadius="14" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="#EDF2FA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="#DCEBFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Item" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Votre vocabulaire" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Retrouvez les mots et expressions expliqués pendant vos sessions de jeu."
                       Foreground="{StaticResource InkSoft}" FontSize="14" Margin="0,5,0,0" />
            <TextBlock x:Name="CountText" Foreground="{StaticResource InkSoft}" FontSize="13" Margin="0,8,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Rechercher un mot, une traduction ou une phrase" FontSize="13" Foreground="{StaticResource InkSoft}" Margin="0,0,0,6" />
            <TextBlock Grid.Column="2" Text="Sessions" FontSize="13" Foreground="{StaticResource InkSoft}" Margin="0,0,0,6" />
            <TextBox x:Name="SearchBox" Grid.Row="1" FontSize="15" Padding="12,9" BorderBrush="#D9DDE3"
                     Background="White" TextChanged="OnFilterChanged" ToolTip="Rechercher un mot, une traduction ou une phrase"
                     AutomationProperties.Name="Rechercher dans le vocabulaire" />
            <ComboBox x:Name="SessionFilter" Grid.Row="1" Grid.Column="2" FontSize="14" Padding="9" SelectedIndex="0"
                      SelectionChanged="OnSessionChanged" AutomationProperties.Name="Filtrer les sessions">
                <ComboBoxItem Content="Toutes les sessions" />
                <ComboBoxItem Content="Cette session" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Padding="10">
                <Grid>
                    <ListBox x:Name="WordList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnWordChanged"
                             AutomationProperties.Name="Mots et expressions traduits">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Definition.Word}" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Definition.Translation}" FontSize="15" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding LastSeenLabel}" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="0,7,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" FontSize="15" TextAlignment="Center" Margin="20"
                               VerticalAlignment="Center" Foreground="{StaticResource InkSoft}" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Detail" Visibility="Collapsed">
                        <TextBlock Text="{Binding Definition.PartOfSpeech}" FontSize="13" Foreground="{StaticResource InkSoft}" />
                        <TextBlock Text="{Binding Definition.Word}" FontSize="32" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Definition.Ipa}" FontSize="17" Foreground="{StaticResource InkSoft}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Definition.Translation}" FontSize="26" FontWeight="SemiBold" Margin="0,20,0,0" />
                        <TextBlock Text="{Binding Definition.ContextMeaning}" FontSize="17" LineHeight="25" Margin="0,8,0,0" />
                        <Border Height="1" Background="#D9DDE3" Margin="0,22,0,18" />
                        <TextBlock Text="Dans le jeu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" />
                        <TextBlock Text="{Binding Sentence}" FontSize="16" LineHeight="24" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding LookupLabel}" FontSize="13" Foreground="{StaticResource InkSoft}" Margin="0,18,0,0" />
                        <WrapPanel Margin="0,18,0,0">
                            <Button x:Name="SpeakWordButton" Style="{StaticResource Action}" Content="Écouter le mot" Click="OnSpeakWord" Margin="0,0,10,8" />
                            <Button x:Name="SpeakContextButton" Style="{StaticResource Action}" Content="Écouter la phrase" Click="OnSpeakSentence" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="{StaticResource InkSoft}"
                       Text="Les traductions sont enregistrées automatiquement sur cet ordinateur." />
            <TextBlock x:Name="HotkeyText" FontSize="13" Foreground="{StaticResource InkSoft}" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Window>
